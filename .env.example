# ==============================================================================
# Toowix Meet — Example Environment Configuration (.env.example)
# ==============================================================================

# Port for the local development server (Default: 8080)
PORT=8080

# Target Jitsi deployment for development proxy (Default: https://alpha.jitsi.net)
WEBPACK_DEV_SERVER_PROXY_TARGET=https://alpha.jitsi.net

# Application Name
APP_NAME="Toowix Meet"

# Google OAuth 2.0 Client ID for Google SSO
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Environment mode (development | production)
NODE_ENV=development

# SMTP email sending
SMTP_ENABLE=true
SMTP_HOST=email.toowix.com
SMTP_PORT=587
SMTP_USER_EMAIL=jayesh@dhkinnovations.com
SMTP_USERNAME=jayesh@dhkinnovations.com
SMTP_PASS=replace-with-your-smtp-password
