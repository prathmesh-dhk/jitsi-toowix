# ==============================================================================
# Toowix Meet Web Application Environment Variables
# ==============================================================================

# Backend API Endpoint (Toowix Express API Server)
VITE_API_URL=http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000

# Jitsi Meet Domain for WebRTC Video Rooms
VITE_JITSI_DOMAIN=meet.toowix.com

# Firebase Client Web SDK Credentials
# (Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment
VITE_FIREBASE_AUTH_DOMAIN=toowix-meet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=toowix-meet
VITE_FIREBASE_STORAGE_BUCKET=toowix-meet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
