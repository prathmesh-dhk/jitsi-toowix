# ==============================================================================
# Toowix Backend Configuration
# This file is gitignored — never commit real secrets.
# Lines marked "NEEDED FROM YOU" are placeholders that must be filled in for
# real auth/email/Jitsi flows to work end to end.
# ==============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- MongoDB ---
# Local/Docker default works out of the box for dev. For real usage, replace
# with a MongoDB Atlas URI: mongodb+srv://<user>:<pass>@cluster.mongodb.net/toowix_meet?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/toowix_meet
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# --- Super Admin Seeding (used by `npm run db:seed`) ---
SUPER_ADMIN_FIREBASE_UID=super-admin-root
SUPER_ADMIN_EMAIL=admin@toowix.com
SUPER_ADMIN_NAME=Toowix Super Admin

# --- Firebase Admin SDK ---
# NEEDED FROM YOU: Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key" (downloads a JSON file). Copy the three fields below.
FIREBASE_PROJECT_ID=toowix-meet
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email (nodemailer / SMTP) ---
# NEEDED FROM YOU: SMTP credentials from your email provider (e.g. SendGrid,
# Mailgun, AWS SES, or a plain SMTP account). Leave SMTP_HOST empty to run in
# dev mode, where emails are logged to MongoDB instead of actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Toowix Meet
EMAIL_FROM_ADDRESS=notifications@toowix.com
SUPPORT_EMAIL=support@toowix.com
APP_URL=http://localhost:3000

# --- CORS ---
# Comma-separated list of browser origins allowed to make credentialed API requests in
# production (e.g. https://talk.toowix.com,https://app.toowix.com). Falls back to APP_URL if
# unset. Ignored outside production (NODE_ENV!=production allows any origin, for local dev).
CORS_ALLOWED_ORIGINS=

# --- Jitsi JWT Signing ---
# NEEDED FROM YOU: JITSI_APP_SECRET must match whatever secret is configured
# on the Prosody mod_auth_token server side (server team task). The dev
# default below works only against a Prosody instance configured to match it.
JITSI_APP_ID=toowix-meet
JITSI_APP_SECRET=toowix-secret-dev-key-change-in-prod
JITSI_DOMAIN=talk.toowix.com
JITSI_TOKEN_EXPIRY_SECONDS=86400

# Set to exactly "true" only after ops has confirmed the Prosody lobby module
# (mod_muc_lobby_rooms) is actually deployed and enforcing on this server. Until then, any
# meeting whose company policy has "Require lobby" turned on will fail closed (503) instead of
# silently minting a token that *claims* lobby protection the server doesn't actually enforce.
JITSI_SERVER_POLICY_VERIFIED=false

# --- Local Jibri recording processing ---
# The finalizer worker and backend share this volume. The worker mounts it
# read/write; the backend may mount the same volume read-only for streaming.
# These values contain no secrets. Put RECORDING_INGEST_KEY in the worker and
# backend runtime environments, never in source control.
RECORDING_PROCESSING_ENABLED=true
RECORDING_ROOT=/storage/recordings
# Relative to RECORDING_ROOT. `.` gives /storage/recordings/<session>/...
RECORDING_OUTPUT_DIR=.
RECORDING_PROCESSING_FFMPEG_PATH=ffmpeg
RECORDING_VIDEO_CODEC=libx264
RECORDING_CRF=23
RECORDING_PRESET=medium
RECORDING_MAX_WIDTH=1920
RECORDING_AUDIO_CODEC=aac
RECORDING_AUDIO_BITRATE=192k
RECORDING_KEEP_SOURCE=true

# Finalizer retry/status settings. These are optional operational tunables.
RECORDING_STABLE_CHECKS=3
RECORDING_STABLE_CHECK_INTERVAL_SECONDS=2
RECORDING_STABLE_TIMEOUT_SECONDS=900
RECORDING_MIN_FREE_BYTES=67108864
RECORDING_PROCESSING_FFPROBE_PATH=ffprobe
RECORDING_BACKEND_URL=http://toowix-backend:4000
# RECORDING_INGEST_KEY=replace-at-deploy-time
# RECORDING_INGEST_KEY_FILE=/config/recording-ingest.key
