# Toowix Backend Configuration
PORT=4000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/toowix_meet?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/toowix_meet

# Super Admin Initial Seeding Credentials
SUPER_ADMIN_FIREBASE_UID=super-admin-root
SUPER_ADMIN_EMAIL=admin@toowix.com
SUPER_ADMIN_NAME=Toowix Super Admin

# Firebase Admin SDK Configuration (Optional: Path to serviceAccountKey.json or Base64 / Env string)
FIREBASE_PROJECT_ID=toowix-meet
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@toowix-meet.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
