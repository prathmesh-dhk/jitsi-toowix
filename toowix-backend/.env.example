# ==============================================================================
# Toowix Backend Configuration
# This file is gitignored — never commit real secrets.
# Lines marked "NEEDED FROM YOU" are placeholders that must be filled in for
# real auth/email/Jitsi flows to work end to end.
# ==============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- MongoDB ---
# Local/Docker default works out of the box for dev. For real usage, replace
# with a MongoDB Atlas URI: mongodb+srv://<user>:<pass>@cluster.mongodb.net/toowix_meet?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/toowix_meet
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# --- Super Admin Seeding (used by `npm run db:seed`) ---
SUPER_ADMIN_FIREBASE_UID=super-admin-root
SUPER_ADMIN_EMAIL=admin@toowix.com
SUPER_ADMIN_NAME=Toowix Super Admin

# --- Firebase Admin SDK ---
# NEEDED FROM YOU: Firebase Console -> Project Settings -> Service Accounts ->
# "Generate new private key" (downloads a JSON file). Copy the three fields below.
FIREBASE_PROJECT_ID=toowix-meet
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email (nodemailer / SMTP) ---
# NEEDED FROM YOU: SMTP credentials from your email provider (e.g. SendGrid,
# Mailgun, AWS SES, or a plain SMTP account). Leave SMTP_HOST empty to run in
# dev mode, where emails are logged to MongoDB instead of actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Toowix Meet
EMAIL_FROM_ADDRESS=notifications@toowix.com
SUPPORT_EMAIL=support@toowix.com
APP_URL=http://localhost:3000

# --- Jitsi JWT Signing ---
# NEEDED FROM YOU: JITSI_APP_SECRET must match whatever secret is configured
# on the Prosody mod_auth_token server side (server team task). The dev
# default below works only against a Prosody instance configured to match it.
JITSI_APP_ID=toowix-meet
JITSI_APP_SECRET=toowix-secret-dev-key-change-in-prod
JITSI_DOMAIN=meet.toowix.com
JITSI_TOKEN_EXPIRY_SECONDS=86400
